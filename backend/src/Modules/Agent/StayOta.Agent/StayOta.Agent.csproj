<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StayOta.Agent</RootNamespace>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>StayOta.Agent</PackageId>
    <Version>0.1.0</Version>
    <Authors>StayOTA</Authors>
    <Description>StayOTA Agent runtime (conversation, Redis sessions, composite catalogs). Depends on StayOta.Agent.Abstractions.</Description>
    <PackageTags>agent;meai;runtime;stayota</PackageTags>
    <PackageProjectUrl>https://github.com/vongzh/ota-agent</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vongzh/ota-agent</RepositoryUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StayOta.Agent.Abstractions\StayOta.Agent.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="OllamaSharp" Version="5.4.30" />
    <PackageReference Include="StackExchange.Redis" Version="3.3.0" />
  </ItemGroup>

</Project>
